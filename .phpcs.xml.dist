<?xml version="1.0"?>
<ruleset name="Southern Destinations 2026">
	<description>WordPress coding standards for the sd-theme-2026 block theme.</description>

	<file>.</file>

	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/dist/*</exclude-pattern>
	<exclude-pattern>*/tests/*/test-results/*</exclude-pattern>
	<exclude-pattern>*/tests/*/playwright-report/*</exclude-pattern>
	<exclude-pattern>*/.claude/*</exclude-pattern>
	<exclude-pattern>*/.specify/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="ps"/>

	<!-- The theme must be silent under the full WordPress standard: Core, Docs and
	     Extra, no exclusions. See AGENTS.md, which requires the patterns directory to
	     pass cleanly. Do not add exclude rules here to quieten a real finding. -->
	<rule ref="WordPress"/>

	<config name="minimum_wp_version" value="6.9"/>

	<!-- PHP 7.4 is the floor style.css declares ("Requires PHP"). -->
	<config name="testVersion" value="7.4-"/>
	<rule ref="PHPCompatibilityWP"/>

	<!-- PHPUnit drives test classes, not WordPress: test-*.php / Test_* is the
	     WordPress core test-suite convention. Narrow exclusions, tests only. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>*/tests/php/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.GlobalVariablesOverride.Prohibited">
		<exclude-pattern>*/tests/php/*</exclude-pattern>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="sd-theme-2026"/>
			</property>
		</properties>
	</rule>

</ruleset>
