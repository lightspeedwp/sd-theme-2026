# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# Target environment. Defaults to dev when unset.
#   dev   https://southerndestinations.lightspeedwp.dev   real content, stub templates
#   local http://localhost:8903                           real theme files, 6 tours only
#
# Never point this at southerndestinations.com — the config refuses to run.
WP_BASE_URL=https://southerndestinations.lightspeedwp.dev

# Admin credentials for the `editor` project, which signs in to check that no
# Site Editor database override is shadowing a theme template file. Leave these
# unset and the `setup` and `editor` projects are not defined: a full run omits
# them, and `npm run test:editor` stops with a project-not-found error.
WP_ADMIN_USER=
WP_ADMIN_PASS=
