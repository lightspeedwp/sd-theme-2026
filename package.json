{
	"name": "sd-theme-2026",
	"version": "0.1.0",
	"description": "Southern Destinations 2026 block theme — lint and test harness.",
	"author": "LightSpeed",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"wordpress-theme",
		"block-theme",
		"full-site-editing"
	],
	"homepage": "https://github.com/lightspeedwp/sd-theme-2026#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lightspeedwp/sd-theme-2026.git"
	},
	"bugs": {
		"url": "https://github.com/lightspeedwp/sd-theme-2026/issues"
	},
	"engines": {
		"node": ">=20.0.0",
		"npm": ">=10.0.0"
	},
	"private": true,
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@playwright/test": "^1.63.0",
		"@wordpress/a11y": "^4.56.0",
		"@wordpress/e2e-test-utils-playwright": "^2.1.0",
		"@wordpress/scripts": "^30.27.0",
		"axe-core": "^4.13.0"
	},
	"overrides": {
		"typescript": "^5.9.0"
	},
	"scripts": {
		"lint": "npm run lint:js && npm run lint:css && npm run lint:md && npm run lint:pkg-json && npm run lint:php && npm run lint:phpstan",
		"lint:js": "wp-scripts lint-js",
		"lint:js:fix": "wp-scripts lint-js --fix",
		"lint:css": "wp-scripts lint-style \"**/*.css\"",
		"lint:css:fix": "wp-scripts lint-style \"**/*.css\" --fix",
		"lint:md": "wp-scripts lint-md-docs",
		"lint:pkg-json": "wp-scripts lint-pkg-json .",
		"lint:php": "composer run lint",
		"lint:php:fix": "composer run lint:fix",
		"lint:phpstan": "composer run phpstan",
		"format": "wp-scripts format",
		"check:engines": "wp-scripts check-engines",
		"check:licenses": "wp-scripts check-licenses --prod --gpl2",
		"check:theme": "php -d memory_limit=1024M $(which wp) eval-file tests/bin/theme-check.php",
		"test": "npm run test:unit && npm run test:php",
		"test:php": "composer run test",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:debug": "playwright test --debug",
		"test:e2e:headed": "playwright test --headed",
		"test:e2e:chrome": "playwright test --project=desktop",
		"test:e2e:firefox": "playwright test --project=firefox",
		"test:e2e:webkit": "playwright test --project=webkit",
		"test:e2e:ci": "playwright test --reporter=dot",
		"test:unit": "wp-scripts test-unit-js",
		"test:unit:watch": "wp-scripts test-unit-js --watch",
		"test:unit:coverage": "wp-scripts test-unit-js --coverage",
		"test:smoke": "playwright test --project=desktop --grep @smoke",
		"test:templates": "playwright test --project=desktop tests/e2e/templates",
		"test:parts": "playwright test --project=desktop tests/e2e/parts",
		"test:forms": "playwright test --project=desktop tests/e2e/forms",
		"test:responsive": "playwright test --project=responsive --project=mobile --project=tablet",
		"test:a11y": "playwright test --project=a11y",
		"test:a11y:baseline": "SD_UPDATE_A11Y_BASELINE=true playwright test --project=a11y",
		"test:editor": "playwright test --project=editor",
		"test:parity": "SD_RUN_PARITY=true playwright test --project=parity",
		"test:visual": "SD_RUN_VISUAL=true playwright test --project=visual",
		"test:visual:update": "SD_RUN_VISUAL=true playwright test --project=visual --update-snapshots",
		"test:report": "playwright show-report tests/e2e/playwright-report",
		"test:install": "playwright install --with-deps chromium firefox webkit"
	}
}
