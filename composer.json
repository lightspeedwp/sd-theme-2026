{
	"name": "lightspeedwp/sd-theme-2026",
	"description": "Southern Destinations 2026 block theme.",
	"type": "wordpress-theme",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "^3.13.6",
		"wp-coding-standards/wpcs": "^3.4.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1.8",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.2.1",
		"phpstan/phpstan": "^2.3",
		"szepeviktor/phpstan-wordpress": "^2.0.4",
		"wp-phpunit/wp-phpunit": "^7.1.1",
		"yoast/phpunit-polyfills": "^4.0"
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"phpstan": "phpstan analyse --memory-limit=1G",
		"test": "@test:integration",
		"test:integration": "phpunit -c phpunit.xml.dist"
	},
	"scripts-descriptions": {
		"lint": "WordPress coding standards and PHP 7.4+ compatibility (.phpcs.xml.dist).",
		"phpstan": "Static analysis against the WordPress stubs.",
		"test:integration": "PHPUnit against the WordPress test suite — needs a throwaway MySQL database (see tests/php/README.md)."
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "7.4.33"
		}
	}
}
