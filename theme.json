	"styles": {
		"blocks": {
			"core/button": {
				"variations": {
					"fill": {
						"color": {
							"background": "var:preset|color|brand-500",
							"text": "var:preset|color|base"
						},
						"border": {
							"radius": "var:preset|border-radius|0",
							"width": "var:custom|border-width|200",
							"style": "solid",
							"color": "transparent"
						},
						"spacing": {
							"padding": {
								"top": "var:custom|spacing|button|padding-vertical",
								"right": "var:custom|spacing|button|padding-horizontal",
								"bottom": "var:custom|spacing|button|padding-vertical",
								"left": "var:custom|spacing|button|padding-horizontal"
							}
						},
						"typography": {
							"fontFamily": "var:preset|font-family|heading",
							"fontSize": "var:preset|font-size|300",
							"fontWeight": "var:custom|font-weight|semi-bold",
							"lineHeight": "var:custom|line-height|button",
							"textTransform": "uppercase",
							"letterSpacing": "var:custom|letter-spacing|narrow"
						},
						":hover": {
							"color": {
								"background": "var:preset|color|brand-600",
								"text": "var:preset|color|base"
							},
							"border": {
								"color": "transparent"
							}
						},
						":focus": {
							"color": {
								"background": "var:preset|color|brand-600",
								"text": "var:preset|color|base"
							}
						}
					},
					"outline": {
						"color": {
							"background": "transparent",
							"text": "var:preset|color|brand-600"
						},
						"border": {
							"radius": "var:preset|border-radius|0",
							"width": "var:custom|border-width|200",
							"style": "solid",
							"color": "var:preset|color|brand-500"
						},
						"spacing": {
							"padding": {
								"top": "var:custom|spacing|button|padding-vertical",
								"right": "var:custom|spacing|button|padding-horizontal",
								"bottom": "var:custom|spacing|button|padding-vertical",
								"left": "var:custom|spacing|button|padding-horizontal"
							}
						},
						"typography": {
							"fontFamily": "var:preset|font-family|heading",
							"fontSize": "var:preset|font-size|300",
							"fontWeight": "var:custom|font-weight|semi-bold",
							"lineHeight": "var:custom|line-height|button",
							"textTransform": "uppercase",
							"letterSpacing": "var:custom|letter-spacing|narrow"
						},
						":hover": {
